# MongoDB connection string
MONGO_URI=mongodb://localhost:27017/portfolio

# JSON Web Token secret for admin authentication
JWT_SECRET=replace_with_a_long_random_secret

# Admin account credentials for seed or login
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=replace_with_a_strong_unique_password

# Cloudinary URL; required for production image uploads
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Optional allowed browser origin and local API URL
CLIENT_ORIGIN=http://localhost:5174
VITE_API_URL=http://localhost:5001/api
